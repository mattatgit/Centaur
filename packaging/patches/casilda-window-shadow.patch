+/* Shadow the main surface's alpha before drawing popups and transients.
+ * Capture the subtree once so each Wayland surface receives one frame callback. */
+static void
+snapshot_main_surface (struct wlr_surface *surface, SnapshotData *data, gint x, gint y)
+{
+  GtkSnapshot *snapshot = data->snapshot;
+  SnapshotData layer = *data;
+  layer.snapshot = gtk_snapshot_new ();
+  snapshot_surface (surface, &layer, x, y);
+  GskRenderNode *node = gtk_snapshot_free_to_node (layer.snapshot);
+  if (!node)
+    return;
+
+  graphene_rect_t bounds;
+  GskRenderNode *blur = gsk_blur_node_new (node, 6);
+  gsk_render_node_get_bounds (blur, &bounds);
+  /* Blur the silhouette at full strength, then apply the tint once. */
+  gtk_snapshot_save (snapshot);
+  gtk_snapshot_translate (snapshot, &GRAPHENE_POINT_INIT (0, 2));
+  gtk_snapshot_push_mask (snapshot, GSK_MASK_MODE_ALPHA);
+  gtk_snapshot_append_node (snapshot, blur);
+  gsk_render_node_unref (blur);
+  gtk_snapshot_pop (snapshot);  /* begin mask source */
+  gtk_snapshot_append_color (snapshot, &(GdkRGBA) { 0, 0, 0, 0.12f }, &bounds);
+  gtk_snapshot_pop (snapshot);
+  gtk_snapshot_restore (snapshot);
+
+  gtk_snapshot_append_node (snapshot, node);
+  gsk_render_node_unref (node);
+}
